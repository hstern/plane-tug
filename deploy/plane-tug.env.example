# Example environment file for plane-tug.
# Deploy to /etc/plane-tug/plane-tug.env on the host (mode 0600, root:root)
# and the quadlet unit picks it up via EnvironmentFile=.

# HMAC secret returned by Plane when the workspace webhook was created.
# Plane only shows this once at create time; capture it from the create
# response and store it here.
PLANE_TUG_WEBHOOK_SECRET=

# Internal URL of Plane's web/API container. Use the container-network
# DNS name — the bridge does not need to leave the local podman network
# to verify sessions.
PLANE_TUG_PLANE_BASE_URL=http://plane-web:3000

# Optional: debug, info (default), warn, error.
# PLANE_TUG_LOG_LEVEL=info
